# ==============================================================================
# GLASSQUIZ - PRODUCTION CONFIGURATION (deploy/.env)
# ==============================================================================
# cp .env.example .env   then change every value marked change-me.
# This file holds secrets: never commit it (it is git-ignored).
# Generate a secret:  openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# HOST PORT & PUBLIC ORIGIN
# ------------------------------------------------------------------------------
# Gateway port on the server (BMS uses 4600, PDF Converter uses 4900, Quiz uses 4950)
PORT_HTTP=4950
# Use 127.0.0.1 when Cloudflare Tunnel or a host reverse proxy sits in front (recommended).
# Use 0.0.0.0 only when testing directly by server IP:4950.
BIND_ADDRESS=127.0.0.1

# Public URL browsers open (used as default CORS allowlist for REST + WebSockets)
PUBLIC_URL=https://quiz.digitechkh.site
# Comma-separated allowed origins (defaults to PUBLIC_URL if omitted)
CORS_ORIGIN=https://quiz.digitechkh.site

# ------------------------------------------------------------------------------
# GITHUB CONTAINER REGISTRY (optional: used with `./rebuild.sh pull`)
# ------------------------------------------------------------------------------
IMAGE_REGISTRY=ghcr.io
# Lowercase GitHub username or organization name that owns the repository
GITHUB_REPOSITORY_OWNER=your-github-username
IMAGE_TAG=latest

# ------------------------------------------------------------------------------
# SHARED POSTGRESQL DATABASE (same PostgreSQL server, own database + user)
# ------------------------------------------------------------------------------
# Set to match the shared PostgreSQL host/port (e.g., host.docker.internal and 5432 or 5434)
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=quiz_db
POSTGRES_USER=glassquiz
# CHANGE. Letters, digits, - and _ only (used inside DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# ------------------------------------------------------------------------------
# SECURITY (CHANGE)
# ------------------------------------------------------------------------------
# Must be >= 16 chars in production: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
