# PostgreSQL Configuration (Shared existing Docker container: local-postgres)
# Localhost (running backend with npm):
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/quiz_db?schema=public"
# Inside Docker network (postgresql_default):
DOCKER_DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@local-postgres:5432/quiz_db?schema=public"

# Redis Configuration (Optional future scaling / docker-compose redis service)
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend API Configuration
NODE_ENV=production
PORT=3000
REQUIRE_DB=true
JWT_SECRET=replace-with-long-random-32-plus-char-secret
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# Frontend Configuration (Leave unset to use same-origin /api and /socket.io proxy)
# VITE_API_URL=http://localhost:3000
# VITE_WS_URL=http://localhost:3000
